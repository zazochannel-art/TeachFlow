# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Daily email reminders (server-only, never NEXT_PUBLIC_). Optional: without them no emails are sent.
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Bypasses RLS; keep it on the server.
SUPABASE_SECRET_KEY=
# https://resend.com → API Keys
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. TeachFlow <noreply@yourdomain.md>
REMINDER_FROM=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Public app URL used for links in emails (defaults to the request origin)
APP_URL=

# Video calls (see docs/video-classroom.md). All server-only: never prefix them with NEXT_PUBLIC_.
# TURN relay for strict networks (mobile data, school Wi-Fi). Without it only STUN is used.
# Cloudflare: dash.cloudflare.com → Realtime → TURN Server → Create (1000 GB/month free, then ~$0.05/GB relayed).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# Or your own coturn (use-auth-secret): comma-separated turn:/turns: URLs + the shared secret → 4 h credentials.
TURN_URLS=
TURN_SECRET=
# (development only) fixed TURN account instead of TURN_SECRET
TURN_USERNAME=
TURN_CREDENTIAL=
# SFU for group lessons: LiveKit Cloud (cloud.livekit.io → project → Settings → API keys) or self-hosted.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# auto (default): SFU for group lessons, P2P for 1:1 · p2p: never SFU · sfu: always SFU
RTC_MODE=

# Push notifications (Web Push). Generate a pair once: npx web-push generate-vapid-keys
# Needs SUPABASE_SECRET_KEY too (the server reads the recipients' devices). Server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI test creator (Teste AI). Server-only key from console.anthropic.com. AI_API_KEY also works.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
AI_MODEL=
