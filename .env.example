# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Daily email reminders (server-only, never NEXT_PUBLIC_). Optional: without them no emails are sent.
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Bypasses RLS; keep it on the server.
SUPABASE_SECRET_KEY=
# https://resend.com → API Keys
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. TeachFlow <noreply@yourdomain.md>
REMINDER_FROM=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Public app URL used for links in emails (defaults to the request origin)
APP_URL=

# Video calls and screen share (optional TURN relay for strict networks; without it only STUN is used).
# Cloudflare Realtime → TURN keys (about $0.05 per relayed GB; only calls that need the relay use it). Server-only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# Or any other TURN server (e.g. coturn, Metered): comma-separated URLs plus static credentials.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
